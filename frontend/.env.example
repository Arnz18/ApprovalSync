# ==============================================================================
# ApprovalSync — Frontend Environment Configuration Template
# Milestone: FE-01 (Frontend shell, design system, routing and API client)
# Note: Copy to .env.local for local overrides. Never commit secrets to Git.
# All VITE_* variables are publicly exposed in the browser bundle.
# ==============================================================================

# API Base URL:
# In development, Vite proxies '/api' to 'http://localhost:3000' (see vite.config.ts).
# Default: /api/v1 (routed through the local dev proxy)
# Alternative direct URL: http://localhost:3000/api/v1
VITE_API_BASE_URL=/api/v1

# Application Environment Name
VITE_APP_ENV=development

# Request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT_MS=15000
