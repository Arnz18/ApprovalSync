# ==============================================================================
# ApprovalSync — Environment Configuration Template
# Milestone: FND-03 (Docker, Environment, Quality Gates & CI Baseline)
# Note: Copy to .env for local development. Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Configuration (Required for host backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) Configuration (Optional)
# Comma-separated list of allowed frontend origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Tracing and Development Overrides (Optional / Development Only)
# When set to true, logs extra request debug metadata
# ------------------------------------------------------------------------------
DEBUG_LOGGING=false

# ------------------------------------------------------------------------------
# Database Configuration (Docker Compose & Local Backend)
# Used by compose.yaml for PostgreSQL 16 container and host backend connection
# Note: In development, default credentials below match compose.yaml defaults.
# WARNING: postgres_dev_password is a local development fallback only.
# Production environments require a strong, unique DB_PASSWORD; validateConfig strictly rejects dev defaults when NODE_ENV=production.
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=approvalsync
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
