# ==============================================================================
# ApprovalSync — Production Environment Configuration Template
# For Docker Compose Deployment on AWS EC2
#
# Instructions:
# 1. On your EC2 server, copy this file to '.env.production':
#    cp .env.production.example .env.production
# 2. Fill in all required production secrets.
# 3. Restrict permissions: chmod 600 .env.production
# 4. NEVER commit '.env.production' to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Port Binding (RakshakGIS Co-Existence)
# ------------------------------------------------------------------------------
# Choose an available host port on your EC2 instance.
# If RakshakGIS or another service uses ports 80 and 443, set this to an unused port
# such as 8080, 8081, 8082, 3001, etc.
# Default: 8080 (Accessed at http://<EC2-PUBLIC-IP>:8080)
APPROVALSYNC_PORT=8080

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
# Database name for ApprovalSync
DB_NAME=approvalsync

# Database user name
DB_USER=approvalsync_user

# MANDATORY: Strong, unique database password (minimum 16 characters recommended).
# NOTE: The application validation strictly rejects 'postgres', 'postgres_dev_password',
# and empty values when NODE_ENV=production.
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD_MIN_16_CHARS

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security
# ------------------------------------------------------------------------------
# MANDATORY: High-entropy cryptographic secret key (minimum 32 characters).
# Used for signing and verifying JSON Web Tokens (HMAC-SHA256).
# Generate on Linux EC2 with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_JWT_SECRET_MIN_32_CHARS_VIA_OPENSSL

# JWT token expiration window (e.g. 3600s, 1h, 8h)
JWT_EXPIRES_IN=3600s

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# In production with the reverse proxy, browser requests are same-origin (/api/).
# For direct domain or multi-domain access, specify comma-separated allowed origins:
# Example: CORS_ORIGINS=http://your-ec2-ip:8080,https://your-domain.com
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. Logging and Production Hardening
# ------------------------------------------------------------------------------
# Logging verbosity: 'warn' or 'error' recommended in production
LOG_LEVEL=warn

# Verbose debug logging (strictly false in production)
DEBUG_LOGGING=false

# Swagger / OpenAPI interactive documentation:
# Set to 'false' in production to prevent schema enumeration; set to 'true' only if needed for evaluation.
ENABLE_SWAGGER=false
